# Copy this file to .env and replace every value before starting the service.
# Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
WEBHOOK_ALLOWED_HOSTS=
POSTGRES_PASSWORD=

# Demo records are opt-in and must remain disabled in production.
DEMO_SEED_ENABLED=false
