# Copy into a secret manager or an ignored local environment file. Never commit real values.
STAGING_BASE_URL=https://staging-tao.example.com
STAGING_DEPLOYMENT_MODE=external
STAGING_RUN_E2E=true
STAGING_ALLOW_HTTP=false

SERVER_MODE=release
DEMO_SEED_ENABLED=false
SERVER_TRUSTED_PROXIES=

JWT_SECRET=
JWT_ISSUER=tao-core-go-staging
JWT_AUDIENCE=tao-core-go-staging-client
APP_ENCRYPTION_KEY=
WEBHOOK_ALLOWED_HOSTS=hooks.staging.example.com

DATABASE_DRIVER=postgres
DATABASE_DSN=host=staging-db.example.com user=tao dbname=tao_core_db sslmode=verify-full
DATABASE_ALLOW_INSECURE_INTERNAL=false

# Stateful E2E values must point to a staging-only delivery that may accumulate test sessions.
E2E_DELIVERY_ID=
E2E_ITEM_ID=
E2E_ITEM_RESPONSE=
E2E_EXPECTED_SCORE=

# Alternatively supply identity-provider-issued tokens instead of allowing local test token generation.
E2E_STUDENT_TOKEN=
E2E_OTHER_STUDENT_TOKEN=
E2E_ADMIN_TOKEN=
